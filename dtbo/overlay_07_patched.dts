	fragment@54 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,pmk8550@0 {

				pon_hlos@1300 {

					resin {
						linux,code = <0x73>;
					};
				};
			};
		};
	};

	fragment@55 {
		target = <0xffffffff>;

		__overlay__ {

			gpio_key {
				pinctrl-0 = <0xcb 0xcc 0xcd>;

				vol_up {
					status = "disabled";
				};

				vol_dn {
					label = "volume_down";
					gpios = <0x2c 0x06 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x72>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};

				cam_snapshot {
					label = "cam_snapshot";
					gpios = <0xce 0x07 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x2fe>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};

				cam_focus {
					label = "cam_focus";
					gpios = <0xce 0x08 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x210>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};

			qcom,qbt_handler {
				status = "disabled";
			};
		};
	};

