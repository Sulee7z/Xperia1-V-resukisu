allow ksu perf_manager chr_file rw_file_perms
allow platform_app sysfs file getattr
allow platform_app sysfs file open
allow platform_app sysfs file read
allow platform_app sysfs file write
allow platform_app sysfs dir search
allow untrusted_app sysfs file getattr
allow untrusted_app sysfs file open
allow untrusted_app sysfs file read
allow untrusted_app sysfs file write
allow untrusted_app sysfs dir search
# Binder service "feas" (feasd daemon) lookup - WITHOUT these the module apps
# cannot find the daemon's service (avc denied find -> frame reporting all 0)
allow platform_app default_android_service service_manager find
allow untrusted_app default_android_service service_manager find
allow system_app default_android_service service_manager find
allow system_server default_android_service service_manager find
