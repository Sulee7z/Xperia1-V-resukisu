CONFIG_DEVTMPFS=y
# Power saving & performance (ported from ryncsn/android-common-kernel android13-5.15-silsrc-yodo-0.2)
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# MGLRU - Multi-Gen LRU (better memory reclaim, smoother under pressure)
CONFIG_LRU_GEN_ENABLED=y
# BBR TCP congestion control (faster & smoother network)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# ReSukiSU (KSU) - source integrated
CONFIG_KSU=y
CONFIG_KSU_TRACEPOINT_HOOK=y
CONFIG_KSU_TOOLKIT_SUPPORT=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# ---- Safe power saving (does NOT affect cgroup freezer / tombstone freeze) ----
# zram: zstd compression (better ratio than lzo-rle default) + writeback
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_WRITEBACK=y
# RCU: NOCB already default in GKI (CONFIG_RCU_NOCB_CPU=y) - keep as is
# No CPUFREQ governor / cpuidle depth changes - freezer latency safety

# ---- LTO: use THIN like v16 (FULL makes Image >45.3MiB and overwrites the
# AVB signature block in the boot partition -> bootloop/5s shutdown) ----
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
# ---- FEAS (FPS-driven energy-aware scheduling, ported perf_mgr) ----
CONFIG_PERF_MGR=y

# ---- Safe optimizations v0.4 (BTF-safe: DEBUG_INFO/BTF stay ON for GKI) ----
# strip gdb scripts (debug bloat, safe)
CONFIG_GDB_SCRIPTS=n

# ---- Tampered-kernel hiding (no SUSFS): spoof /proc/cmdline + /proc/bootconfig
# Kernel keeps using the real cmdline/bootconfig; only the procfs views are
# replaced with stock-like content (strings filled after capture from device).
CONFIG_KSU_CMDLINE_SPOOF=y
CONFIG_KSU_CMDLINE_SPOOF_STRING="stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected cgroup_disable=pressure console=ttyMSM0,115200n8 loglevel=6 kpti=0 log_buf_len=256K kernel.panic_on_rcu_stall=1 service_locator.enable=1 msm_rtb.filter=0x237 rcupdate.rcu_expedited=1 rcu_nocbs=0-7 ftrace_dump_on_oops swiotlb=noforce loop.max_part=7 fw_devlink.strict=1 allow_mismatched_32bit_el0 cpufreq.default_governor=performance printk.console_no_auto_verbose=1 kasan=off sysctl.kernel.sched_pelt_multiplier=4 can.stats_timer=0 pcie_ports=compat irqaffinity=0-2 disable_dma32=on no-steal-acc cgroup.memory=nokmem,nosocket video=vfb:640x400,bpp=32,memsize=3072000 nosoftlockup bootconfig  msm_drm.dsi_display0=somc,1_panel: rootwait ro init=/init  oembootloader.startup=0x00008004 oembootloader.warmboot=0x77665502 oembootloader.securityflags=0x00000003"
CONFIG_KSU_BOOTCONFIG_SPOOF=y
CONFIG_KSU_BOOTCONFIG_SPOOF_STRING="androidboot.hardware = \"qcom\"\\nandroidboot.hardware.sku = \"c001526\"\\nandroidboot.hardware.color = \"163\"\\nandroidboot.memcg = \"1\"\\nandroidboot.usbcontroller = \"a600000.dwc3\"\\nandroidboot.init_fatal_panic = \"true\"\\nandroidboot.bootdevice = \"1d84000.ufshc\"\\nandroidboot.boot_devices = \"soc/1d84000.ufshc\"\\nandroidboot.baseband = \"msm\"\\nandroidboot.dtbo_idx = \"7\"\\nandroidboot.dtb_idx = \"1\"\\nandroidboot.fstab_suffix = \"default\"\\nandroidboot.verifiedbootstate = \"orange\"\\nandroidboot.keymaster = \"1\"\\nandroidboot.vbmeta.device = \"PARTUUID=87ea1d55-4627-4a22-bfe0-7860349b4659\"\\nandroidboot.vbmeta.avb_version = \"1.2\"\\nandroidboot.vbmeta.device_state = \"unlocked\"\\nandroidboot.vbmeta.hash_alg = \"sha256\"\\nandroidboot.vbmeta.size = \"20352\"\\nandroidboot.vbmeta.digest = \"2c0d209f08b83affc8aec9a76dba52ffde416fc92e036f434834bc6aeaf08962\"\\nandroidboot.veritymode = \"enforcing\"\\nandroidboot.veritymode.managed = \"yes\"\\nandroidboot.slot_suffix = \"_a\"\\noemandroidboot.babe09a9 = \"00\"\\noembootloader.securityflags = \"0x00000003\""
